{
  "slug": "lanelab",
  "name": "Lanelab",
  "version": "0.1.0",
  "language": "LANGUAGE_TYPESCRIPT",
  "settings": [
    {
      "key": "accent",
      "label": "Accent color",
      "kind": "KIND_CHOICE",
      "choices": [
        { "value": "coral", "label": "Coral" },
        { "value": "gold", "label": "Gold" },
        { "value": "cyan", "label": "Cyan" },
        { "value": "violet", "label": "Violet" }
      ],
      "default": "coral"
    },
    {
      "key": "display",
      "label": "Display",
      "kind": "KIND_CHOICE",
      "choices": [
        { "value": "text", "label": "Text (always works)" },
        { "value": "panel", "label": "Panels" },
        { "value": "both", "label": "Text and panels" }
      ],
      "default": "text"
    },
    {
      "key": "hud",
      "label": "HUD size",
      "kind": "KIND_CHOICE",
      "choices": [
        { "value": "full", "label": "Full" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "full"
    },
    {
      "key": "length",
      "label": "Aim Range length",
      "kind": "KIND_CHOICE",
      "choices": [
        { "value": "30", "label": "30 seconds" },
        { "value": "60", "label": "60 seconds" },
        { "value": "90", "label": "90 seconds" }
      ],
      "default": "60"
    }
  ],
  "metrics": [
    { "name": "aim.score", "kind": "KIND_MAX", "labels": ["click", "head", "strafe", "flick", "switch", "track", "long"] },
    { "name": "aim.headshots", "kind": "KIND_SUM" },
    { "name": "lasthit.clean", "kind": "KIND_SUM" },
    { "name": "lasthit.souls", "kind": "KIND_MAX" },
    { "name": "rush.runs", "kind": "KIND_COUNT" },
    { "name": "rush.pace", "kind": "KIND_MAX" },
    { "name": "flow.score", "kind": "KIND_MAX" },
    { "name": "flow.top", "kind": "KIND_MAX" },
    { "name": "route.runs", "kind": "KIND_COUNT" },
    { "name": "duel.kills", "kind": "KIND_SUM" },
    { "name": "duel.wins", "kind": "KIND_COUNT" }
  ]
}
