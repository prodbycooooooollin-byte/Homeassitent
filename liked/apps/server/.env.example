# LIKED-Server – Beispielkonfiguration (keine echten Secrets eintragen und NICHT committen)

# Netzwerk
PORT=8787
HOST=0.0.0.0
# Öffentliche HTTPS-Adresse (für Beitrittslinks und den TikTok-Redirect)
PUBLIC_URL=https://liked.example.org
# Nur hinter einem vertrauenswürdigen Reverse Proxy (Caddy/nginx) auf 1 setzen
TRUST_PROXY=1
MAX_ROOMS=200
LOG_LEVEL=info

# Datenverzeichnis (nur verschlüsselter Auth-Speicher des offiziellen TikTok-Adapters)
DATA_DIR=./data

# --- Offizieller TikTok-Adapter (optional; ohne diese Werte nur Demo-Partien) ---
# Erfordert eine bei TikTok registrierte und für die Data Portability API freigegebene App.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://liked.example.org/auth/tiktok/callback
# TIKTOK_SCOPES=user.info.basic,portability.activity.ongoing
# 32 zufällige Bytes, base64 – z. B.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
