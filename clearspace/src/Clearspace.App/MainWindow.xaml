<Window x:Class="Clearspace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Clearspace.App.Views"
        Title="Clearspace" Height="760" Width="1180" MinHeight="520" MinWidth="880"
        Background="{DynamicResource SurfaceBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,20">
                <TextBlock Text="Clearspace" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Text="Ordnung fuer deinen Desktop" Style="{StaticResource Caption}" Margin="0,0,0,18" />

                <Button x:Name="NavLauncher" Content="Start und Suche" Click="Navigate_Click" Tag="Launcher"
                        HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button x:Name="NavLibrary" Content="Bibliothek" Click="Navigate_Click" Tag="Library"
                        HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button x:Name="NavCleanup" Content="Aufraeumen" Click="Navigate_Click" Tag="Cleanup"
                        HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button x:Name="NavRules" Content="Regeln" Click="Navigate_Click" Tag="Rules"
                        HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button x:Name="NavHistory" Content="Verlauf und Wiederherstellung" Click="Navigate_Click" Tag="History"
                        HorizontalContentAlignment="Left" Margin="0,0,0,6" />
                <Button x:Name="NavSettings" Content="Einstellungen" Click="Navigate_Click" Tag="Settings"
                        HorizontalContentAlignment="Left" Margin="0,0,0,6" />

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Eingang" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="{Binding InboxCount, StringFormat={}{0} Eintraege ohne sichere Zuordnung}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Inhalt -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="24,20,24,8">
            <views:OnboardingView x:Name="OnboardingPage" DataContext="{Binding Onboarding}" Visibility="Collapsed" />
            <views:LauncherView x:Name="LauncherPage" DataContext="{Binding Launcher}" />
            <views:LibraryView x:Name="LibraryPage" DataContext="{Binding Library}" Visibility="Collapsed" />
            <views:CleanupView x:Name="CleanupPage" DataContext="{Binding Cleanup}" Visibility="Collapsed" />
            <views:RulesView x:Name="RulesPage" DataContext="{Binding Rules}" Visibility="Collapsed" />
            <views:HistoryView x:Name="HistoryPage" DataContext="{Binding History}" Visibility="Collapsed" />
            <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>

        <!-- Statuszeile -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </Border>
    </Grid>
</Window>
