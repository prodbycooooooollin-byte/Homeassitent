<UserControl x:Class="Clearspace.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Bibliothek" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Ein Eintrag kann zu mehreren Kategorien gehoeren. Es entsteht dabei keine zweite Datei." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="CategoryTree" Grid.Column="0" Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding Categories}"
                      SelectedItemChanged="CategoryTree_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Header}" Margin="2,4" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <ListBox x:Name="EntryList" Grid.Column="1" Margin="12,0"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" Margin="0,2" CornerRadius="8"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding ReasonLabel}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Path}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Noch zuordnen" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Hier landet alles, wofuer es keine belastbaren Hinweise gibt. Clearspace raet nicht." />
                    <ListBox x:Name="InboxList" ItemsSource="{Binding Inbox}" MaxHeight="220" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Margin="0,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Zuordnung aendern" Style="{StaticResource SectionTitle}" />
                    <ComboBox x:Name="CategoryPicker" DisplayMemberPath="Name" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Als Hauptkategorie" Click="SetPrimary_Click" />
                        <Button Content="Zusaetzlich" Click="AddCategory_Click" />
                    </StackPanel>

                    <TextBlock Text="Regelvorschlaege" Style="{StaticResource SectionTitle}"
                               Visibility="{Binding PendingRuleSuggestions.Count, Converter={StaticResource CountToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PendingRuleSuggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Vorschau" Click="PreviewRule_Click" Tag="{Binding}" />
                                            <Button Content="Uebernehmen" Style="{StaticResource PrimaryButton}"
                                                    Click="AcceptRule_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding Status}" />
    </Grid>
</UserControl>
