<UserControl x:Class="Clearspace.App.Views.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Alles schnell finden" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Tippe los. Pfeiltasten waehlen aus, Eingabetaste startet, Escape schliesst das Fenster." />
            <TextBox x:Name="SearchBox" Margin="0,12,0,0" FontSize="16"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=80}"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,10"
                Visibility="{Binding ConfirmationQuestion, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <TextBlock Text="Bitte bestaetigen" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                <TextBlock Text="{Binding ConfirmationQuestion}" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Starten" Style="{StaticResource PrimaryButton}" Click="ConfirmLaunch_Click" />
                    <Button Content="Abbrechen" Click="CancelConfirm_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ResultList" Grid.Column="0"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     MouseDoubleClick="ResultList_MouseDoubleClick"
                     PreviewKeyDown="ResultList_PreviewKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" Margin="0,2" CornerRadius="8"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Source="{Binding IconSourcePath, Converter={StaticResource PathToIcon}, IsAsync=True}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ReasonLabel}" />
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}"
                                               Text="{Binding NonLaunchableHint}"
                                               Visibility="{Binding NonLaunchableHint, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}"
                                           Text="{Binding TypeLabel}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Oeffnen" Click="Open_Click" />
                        <MenuItem Header="Im Explorer anzeigen" Click="Reveal_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Angeheftet" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Zuletzt ueber Clearspace geoeffnet" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding RecentlyOpened}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Haeufig ueber Clearspace geoeffnet" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding FrequentlyOpened}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0"
                               Text="Gezaehlt werden ausschliesslich Starts aus Clearspace. Es findet keine systemweite Beobachtung statt." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
