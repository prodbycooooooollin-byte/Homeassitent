<UserControl x:Class="Clearspace.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Aufraeumen" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Erst die Vorschau, dann die Aktion. Jede Verschiebung laesst sich rueckgaengig machen - auch nach einem Neustart." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeLauncher" Content="Aufgeraeumter Desktop mit Bibliothek (empfohlen)"
                                 IsChecked="True" Checked="Mode_Checked" Tag="LauncherLibrary" Margin="0,0,16,0" />
                    <RadioButton x:Name="ModeFolders" Content="Klassische Ordner"
                                 Checked="Mode_Checked" Tag="FolderOrganisation" Margin="0,0,16,0" />
                    <RadioButton x:Name="ModeVisibility" Content="Nur Sichtbarkeit (manuell)"
                                 Checked="Mode_Checked" Tag="VisibilityOnly" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding ModeExplanation}" />
                <StackPanel x:Name="VisibilityHelp" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock x:Name="VisibilityHelpText" Style="{StaticResource Caption}" />
                    <Button Content="Windows-Einstellungen oeffnen" Margin="0,8,0,0" Click="OpenWindowsSettings_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Vorschau erstellen" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreatePlanCommand}" />
                    <Button Content="Ausgewaehlte Aktionen ausfuehren" Click="Execute_Click" />
                    <Button Content="Rueckgaengig" Command="{Binding UndoCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding PlannedActions}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" Margin="0,2" CornerRadius="8"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsFileAction}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding EntryName}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding KindBadge}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Reason}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding FromPath, StringFormat=Bisher: {0}}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ToPath, StringFormat=Neu: {0}}" />
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}"
                                               Text="{Binding SkipExplanation}"
                                               Visibility="{Binding SkipExplanation, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Bleibt sichtbar auf dem Desktop" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Remaining}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Explanation}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Protokoll" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ExecutionMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding Status}" />
    </Grid>
</UserControl>
