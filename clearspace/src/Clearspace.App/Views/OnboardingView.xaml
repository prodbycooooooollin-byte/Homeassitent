<UserControl x:Class="Clearspace.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Willkommen bei Clearspace" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="In wenigen Schritten ist dein Desktop aufgeraeumt. Es wird nichts veraendert, bevor du eine konkrete Vorschau bestaetigt hast." />

            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Diese Orte schaue ich mir an" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Sources}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Path}" Margin="24,0,0,0" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" Margin="24,0,0,0"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="Clearspace durchsucht niemals ungefragt die ganze Festplatte. Weitere Ordner kannst du spaeter selbst auswaehlen." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ergebnis der Erfassung" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScanResultText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Noch nicht durchgefuehrt." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Jetzt erfassen" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
                <Button Content="Weiter zum Aufraeumen" Click="Finish_Click" />
            </StackPanel>

            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="{Binding Status}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
