# Konfigurationsvorlage für das CITADEL-Recherche-Backend (server/). KEINE Geheimnisse committen.
# Kopieren nach .env und Werte setzen; der Dienst liest ausschließlich Umgebungsvariablen.

# --- Grundbetrieb
CITADEL_PORT=8787
CITADEL_HOST=0.0.0.0
CITADEL_DB=server/data/citadel.sqlite
# Pflicht für Liquipedia (Nutzungsbedingungen): Projekt + Kontakt im User-Agent
CITADEL_USER_AGENT=CITADEL-Research/0.1 (+https://example.org/citadel; kontakt@example.org)
# Origins der Clients (Tauri-App, Browser-Version)
CITADEL_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Token für /v1/admin/* (Betreiber-Prüfansicht für Ausnahmen). Leer = Admin-Endpunkte deaktiviert.
CITADEL_ADMIN_TOKEN=

# --- Intervalle (Stunden)
CITADEL_SETTINGS_INTERVAL_HOURS=18
CITADEL_DISCOVERY_INTERVAL_HOURS=72

# --- Optionale Anbieter (ohne Schlüssel bleibt die jeweilige Quelle sichtbar „inaktiv“)
# Claude API für die Freitext-Extraktion (nur wenn Regeln nichts finden; Ergebnis-Cache je Inhalts-Hash)
ANTHROPIC_API_KEY=
CITADEL_AI_MODEL=claude-opus-5-5
CITADEL_AI_DAILY_BUDGET_USD=2
# Suchanbieter
BRAVE_SEARCH_API_KEY=
# YouTube Data API v3 (nur öffentliche Videobeschreibungen belegter Kanäle)
YOUTUBE_API_KEY=
# GitHub REST (erhöht das Limit von 60 auf 5000 Anfragen/h)
GITHUB_TOKEN=

# --- Nur Entwicklung
# Fiktive Demo-Einträge (getrennt markiert, nur mit ?demo=1 sichtbar)
CITADEL_DEMO=0
