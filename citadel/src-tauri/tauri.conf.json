{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CITADEL",
  "version": "0.1.0",
  "identifier": "app.citadel.deadlock-settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CITADEL – Deadlock Settings & Performance",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:8787 http://localhost:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Deadlock-Configs verstehen, ändern, vergleichen und sicher anwenden",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
