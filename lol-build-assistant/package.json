{
  "name": "lol-build-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Dynamischer, erklärbarer Item-Berater für League of Legends (Windows-Overlay).",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "start:sim": "npm run build && electron . --simulation",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx src/cli/demo.ts",
    "patch:sync": "tsx scripts/patch-sync.ts",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "local.lol-build-assistant",
    "productName": "LoL Build-Assistent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "LoL-Build-Assistent-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "LoL-Build-Assistent-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "author": "prodbycooooooollin-byte",
  "repository": {
    "type": "git",
    "url": "https://github.com/prodbycooooooollin-byte/Homeassitent.git"
  }
}
