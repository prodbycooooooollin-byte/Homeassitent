DISCORD_TOKEN=dein-bot-token
# Whisper-Modell: tiny, base, small, medium (größer = genauer, aber langsamer)
WHISPER_MODEL=medium
# Sprache der Gespräche ("de", "en", ...) oder leer für automatische Erkennung
WHISPER_LANGUAGE=de
# SQLite-Datei für die Zähler
DB_PATH=counter.db

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Passwort für das Dashboard (leer = kein Passwort). Benutzername ist beliebig.
DASHBOARD_PASSWORD=
TIMEZONE=Europe/Berlin
# Eigene Wörter für die Spracherkennung (verbessert die Treffer bei Slang), leer = Standardliste
# WHISPER_PROMPT=Gespräch unter Freunden: droppen, Lobby, Squad, ...
