# Kopiere diese Datei nach .env (wird nicht eingecheckt) und trage deine Werte ein.
# Der Zugriffstoken bleibt ausschließlich auf dem lokalen LumaHome-Server und
# wird nie an den Browser, in Hauspläne oder Exporte weitergegeben.

# Adresse deiner Home-Assistant-Instanz (ohne /api)
HA_URL=http://homeassistant.local:8123
# Langlebiger Zugriffstoken (Home Assistant -> Profil -> Sicherheit)
HA_TOKEN=

# Port des LumaHome-Servers
PORT=8787
# Netzwerkschnittstelle. 127.0.0.1 = nur dieser Rechner, 0.0.0.0 = im Heimnetz (z. B. Wandtablet)
HOST=127.0.0.1

# Optionale Berechtigungen (leer = keine PIN nötig):
# PIN zum Betrachten und Steuern
LUMAHOME_VIEW_PIN=
# PIN zum Bearbeiten von Grundriss, Einrichtung, Zuordnungen und Messquellen
LUMAHOME_EDIT_PIN=

# Speicherort für Projekt und Sitzungsschlüssel
LUMAHOME_DATA_DIR=./data
