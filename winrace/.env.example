# Kopiere diese Datei nach .env (lokal) bzw. hinterlege die Variablen in
# deiner Hosting-Umgebung. Alle Secrets bleiben ausschließlich serverseitig.

# --- Datenbank -------------------------------------------------------------
DATABASE_URL="postgresql://winrace:winrace@localhost:5432/winrace?schema=public"

# --- Auth --------------------------------------------------------------
# Erzeugen mit: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Twitch OAuth (optional) -------------------------------------------
# https://dev.twitch.tv/console/apps – OAuth Redirect URL:
# <NEXTAUTH_URL>/api/auth/callback/twitch
# Ohne diese Variablen ist der "Mit Twitch anmelden"-Button ausgeblendet,
# der Rest der App funktioniert weiterhin (E-Mail/Passwort-Login).
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Wird zusätzlich für die App-Access-Token-Auth der Twitch Helix API
# genutzt (Live-Status, Nutzer-Validierung in der Stream-Zentrale). Kann
# mit denselben Werten wie oben befüllt werden.

# --- E-Mail (Passwort-Reset) --------------------------------------------
# Ohne SMTP-Konfiguration wird der Reset-Link stattdessen in die
# Server-Konsole geschrieben (praktisch für lokale Entwicklung).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="WinRace <no-reply@winrace.app>"

# --- Sonstiges -----------------------------------------------------------
# Öffentlich erreichbarer Hostname (ohne Protokoll), wird u.a. für
# Twitch-Embed-`parent`-Parameter serverseitig als Default verwendet.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Port des kombinierten Next.js + Socket.io Servers (server.ts)
PORT="3000"
