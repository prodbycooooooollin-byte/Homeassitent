# --- AI layer (server-side only; never exposed to the browser) ---
# Enables AI answers (/api/ask) and screenshot recognition (/api/scan).
# Without a key the app still works: answers are assembled directly from the
# knowledge base and Intel Scan clearly reports that recognition is offline.
ANTHROPIC_API_KEY=

# Optional overrides
# VICE_INTEL_MODEL=claude-opus-5-5
# VICE_INTEL_ASK_LIMIT_PER_MIN=12
# VICE_INTEL_SCAN_LIMIT_PER_MIN=4
# VICE_INTEL_MAX_UPLOAD_MB=8

# Public site URL (used for canonical URLs, sitemap, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
