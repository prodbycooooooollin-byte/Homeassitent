# Deadlock-API (https://api.deadlock-api.com). Ein Key ist optional, erhöht aber die Rate-Limits.
DEADLOCK_API_URL=https://api.deadlock-api.com
DEADLOCK_API_KEY=
# Assets (Heldennamen/-icons)
DEADLOCK_ASSETS_URL=https://assets.deadlock-api.com
# Hintergrund-Poller im Server: Intervall in Sekunden (Standard 20)
POLL_INTERVAL_S=20
# 1 = Demo-Daten statt echter API (zum Ausprobieren ohne Netzwerk)
DEADLOCK_DEMO=0
