{
  "name": "deadlock-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "node scripts/prepare-desktop.mjs && electron .",
    "dist:win": "node scripts/prepare-desktop.mjs && electron-builder --win --publish never",
    "dist:installer": "node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "deadem": "^4.0.1",
    "electron-updater": "^6.8.9",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "unbzip2-stream": "^1.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.19",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "description": "Deadlock-Match-Tracker (Web-App + Windows-Desktop-App)",
  "main": "electron/main.js",
  "author": "prodbycooooooollin-byte",
  "build": {
    "appId": "local.deadlock-tracker",
    "productName": "Deadlock Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "app-icons/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app-icons/icon.ico"
    },
    "nsis": {
      "artifactName": "Deadlock-Tracker-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "app-icons/icon.ico",
      "uninstallerIcon": "app-icons/icon.ico",
      "installerHeaderIcon": "app-icons/icon.ico",
      "shortcutName": "Deadlock Tracker",
      "include": "installer-assets/installer.nsh",
      "installerHeader": "installer-assets/header.bmp",
      "installerSidebar": "installer-assets/sidebar.bmp",
      "uninstallerSidebar": "installer-assets/sidebar.bmp",
      "language": "1031",
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Deadlock-Tracker-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/prodbycooooooollin-byte/Homeassitent/releases/download/dt-latest"
      }
    ],
    "asarUnpack": [
      "electron/replay-worker.bundle.mjs"
    ]
  }
}
