{
  "name": "deadlock-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "node scripts/prepare-desktop.mjs && electron .",
    "dist:win": "node scripts/prepare-desktop.mjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "description": "Deadlock-Match-Tracker (Web-App + Windows-Desktop-App)",
  "main": "electron/main.js",
  "author": "prodbycooooooollin-byte",
  "build": {
    "appId": "local.deadlock-tracker",
    "productName": "Deadlock Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Deadlock-Tracker-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Deadlock-Tracker-${version}-portable.${ext}"
    }
  }
}
