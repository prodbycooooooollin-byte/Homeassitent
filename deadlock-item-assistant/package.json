{
  "name": "deadlock-item-assistant",
  "version": "0.3.0",
  "private": true,
  "description": "Dynamischer, erklärbarer Item-Berater für Deadlock (Windows-Overlay).",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "start:demo": "npm run build && electron . --demo",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx src/cli/demo.ts",
    "probe": "tsx src/cli/probe.ts",
    "gamedata:fetch": "tsx scripts/fetch-gamedata.ts",
    "gamedata:extract": "tsx scripts/extract-gamedata.ts",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "start:ow": "npm run build && ow-electron .",
    "vision:refs": "tsx scripts/build-vision-refs.ts"
  },
  "build": {
    "appId": "local.deadlock-item-assistant",
    "productName": "Deadlock Item-Assistent",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*",
          "!raw/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Deadlock-Item-Assistent-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Deadlock-Item-Assistent-${version}-portable.${ext}"
    },
    "asar": false
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@types/node": "^22.7.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "author": "prodbycooooooollin-byte",
  "repository": {
    "type": "git",
    "url": "https://github.com/prodbycooooooollin-byte/Homeassitent.git"
  },
  "overwolf": {
    "packages": [
      "gep"
    ]
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0"
  }
}
