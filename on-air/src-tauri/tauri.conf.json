{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ON AIR",
  "version": "0.2.0",
  "identifier": "app.onair.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ON AIR",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.scdn.co https://*.spotifycdn.com data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "ON AIR",
    "shortDescription": "Now Playing, Songrequests und OBS-Widgets für Spotify und Twitch",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false,
        "headerImage": "installer-assets/header.bmp",
        "sidebarImage": "installer-assets/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": [
          "de-DE",
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
