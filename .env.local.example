# Kopiere diese Datei nach .env.local, um die App mit einer echten
# Home-Assistant-Instanz zu verbinden (Demo-Modus muss in den
# Einstellungen der App deaktiviert werden).
#
# Das Zugriffstoken verlässt den Server niemals - es wird ausschließlich
# von app/api/ha/[...path]/route.ts verwendet, um Anfragen an Home
# Assistant weiterzuleiten. Erzeuge ein Long-Lived Access Token unter
# Home Assistant -> Profil -> Sicherheit -> Langlebige Zugriffstoken.

HA_URL=https://homeassistant.local:8123
HA_TOKEN=dein-langlebiges-zugriffstoken
